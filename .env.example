# ---- Auth (static single user for now) ----
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-please

# Secret used to sign session cookies. MUST be changed in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# How long a login session lasts (seconds). Default 12h.
SESSION_TTL_SECONDS=43200

# ---- Server ----
PORT=8080

# Where collection JSON files are persisted (mounted as a volume in Docker).
DATA_DIR=./data

# Max request/response body size the executor will handle.
MAX_BODY_MB=50

# Per-request timeout in ms for the server-side executor.
REQUEST_TIMEOUT_MS=60000

# Set to "true" to send the auth cookie only over HTTPS (recommended in prod behind TLS).
SECURE_COOKIE=false

# ---- Flx (shared) collections from S3 ----
# The server lists every *.json under this bucket/prefix and serves them to all
# users as READ-ONLY "Flx" collections. Leave FLX_S3_BUCKET blank to disable Flx.
FLX_S3_BUCKET=
FLX_S3_PREFIX=collections/
FLX_S3_REGION=us-east-1
# How long the server caches the S3 listing before re-pulling (the UI's ⟳ forces a refresh).
FLX_CACHE_TTL_SECONDS=300

# Credentials come from the standard AWS provider chain. On the whitelisted AWS host,
# that's the instance/task IAM role (needs s3:ListBucket + s3:GetObject on the bucket) —
# no keys needed here. For local dev only, you may instead set:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ---- SOCKS5 egress proxy ----
# Lets a developer run an integration job locally (e.g. from IntelliJ) while its
# traffic exits from THIS whitelisted host. Point the JVM at it:
#   -DsocksProxyHost=<this-host> -DsocksProxyPort=1080
#   -Djava.net.socks.username=<SOCKS_USERNAME> -Djava.net.socks.password=<SOCKS_PASSWORD>
# Disabled by default. Requires a password. RESTRICT the port to known dev IPs.
SOCKS_ENABLED=false
SOCKS_PORT=1080
# Defaults to AUTH_USERNAME / AUTH_PASSWORD if left blank.
SOCKS_USERNAME=
SOCKS_PASSWORD=
# Optional allowlist of source IPs/CIDRs permitted to use the proxy (comma-separated).
# Supports exact IPs and ranges, e.g. a VPN subnet: SOCKS_ALLOW_IPS=10.8.0.0/16
# Leave blank if the security group / VPN already restricts who can reach the port.
SOCKS_ALLOW_IPS=
SOCKS_CONNECT_TIMEOUT_MS=20000
